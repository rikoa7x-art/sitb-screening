{
  "manifest_version": 3,
  "name": "SITB Skrining Assistant",
  "version": "1.0",
  "description": "Asisten pengisian form SITB dari data skrining warga",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.supabase.co/*",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SITB Assistant"
  }
}
